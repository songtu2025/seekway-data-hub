APP_ENV=local
LOG_LEVEL=INFO
LOG_DIR=logs

JIJIA_BASE_URL=https://open.gerpgo.com
JIJIA_OPEN_GATEWAY_PREFIX=/api/open
JIJIA_APP_ID=your_app_id
JIJIA_APP_KEY=your_app_key
JIJIA_TOKEN_URL=/api_token

DB_HOST=your-polardb-host.mysql.polardb.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=jijia_sync
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TLS_MODE=disabled
DB_TLS_CA_PATH=
# 仅在数据库域名全部解析为 RFC1918 私网地址且数据库不支持 TLS 时启用
DB_ALLOW_UNENCRYPTED_PRIVATE_NETWORK=false

# 运行时连接池与生产进程预算；当前预算包含 API workers、Scheduler 和全部 Worker
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECTION_BUDGET=40
API_WORKERS=2
WORKER_PROCESSES=4

API_CONFIG_PATH=config/api_config.example.yaml
API_CATALOG_PATH=config/jijia_api_catalog.generated.json

# 积加全部账号共享单接口额度；运行时按官方阈值的 90% 均匀调用
JIJIA_RATE_LIMIT_UTILIZATION=0.90
JIJIA_TOKEN_RATE_LIMIT_REQUESTS=10
JIJIA_TOKEN_RATE_LIMIT_PERIOD_SECONDS=1

# Web 服务和认证
PUBLIC_WEB_URL=http://localhost:5173
SESSION_COOKIE_NAME=jijia_session
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
INVITATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 邮件：本地使用 console，生产必须使用 smtp
MAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 积加账号凭证加密；使用 Fernet.generate_key() 生成，禁止提交真实值
CREDENTIAL_ENCRYPTION_KEY=

# Worker 轮询、心跳和失联恢复
WORKER_NAME=
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_MINUTES=10
SYNC_LOCK_SCOPE=account
