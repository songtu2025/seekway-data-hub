{
  "path": [
    "app",
    "backend/app",
    "frontend/src",
    "scripts"
  ],
  "format": [
    "python",
    "typescript",
    "tsx",
    "css",
    "powershell"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "**/test/**",
    "**/tests/**",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**"
  ],
  "reporters": [
    "console"
  ]
}
