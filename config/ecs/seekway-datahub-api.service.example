[Unit]
Description=SEEKWAY Data Hub API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_ROOT__
Environment=API_WORKERS=2
EnvironmentFile=__ENV_FILE__
Environment=PYTHONUNBUFFERED=1
ExecStartPre=__PROJECT_ROOT__/.venv/bin/python -m backend.app.release_preflight --confirm-read-only-database --service api
ExecStart=__PROJECT_ROOT__/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers ${API_WORKERS}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
