[Unit]
Description=SEEKWAY Data Hub Scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__ENV_FILE__
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=seekway-data-hub
RuntimeDirectoryMode=0750
ExecStartPre=__PROJECT_ROOT__/.venv/bin/python -m backend.app.release_preflight --confirm-read-only-database --service scheduler
ExecStart=/usr/bin/flock --no-fork --nonblock /run/seekway-data-hub/scheduler.lock __PROJECT_ROOT__/.venv/bin/python -m backend.app.scheduler
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
