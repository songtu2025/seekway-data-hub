[Unit]
Description=SEEKWAY Data Hub Worker %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__ENV_FILE__
Environment=WORKER_PROCESSES=__WORKER_PROCESSES__
Environment=WORKER_NAME=%i
Environment=PYTHONUNBUFFERED=1
ExecStartPre=__PROJECT_ROOT__/.venv/bin/python -m backend.app.release_preflight --confirm-read-only-database --service worker
ExecStart=__PROJECT_ROOT__/.venv/bin/python -m backend.app.worker
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=3h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
